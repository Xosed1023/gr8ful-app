<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la vista previa del selector de widgets (en pantalla se sustituye por el lienzo dibujado). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F6F6" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#99D9ACFD"
                android:endColor="#00D9ACFD" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#8C8DCDFF"
                android:endColor="#008DCDFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
